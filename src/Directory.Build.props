<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup>
    <Version>0.1.0</Version>
    <Authors>Patrick Garcia</Authors>
    <Product>Abacus API Client</Product>
    <Description>Unofficial C# client for the Abacus ERP REST API (OData), generated with NSwag. Not affiliated with Abacus Research AG.</Description>
    <RepositoryUrl>https://github.com/garcipat/abacus-client</RepositoryUrl>
  </PropertyGroup>

</Project>
